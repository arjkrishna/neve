# --- TopBrain dataset -------------------------------------------------
# The grafted anatomies ARE the deliverable and are committed. Everything
# else under topbrain_data is either the 1.9 GB upstream download or a
# regenerable intermediate of it (surfaces, raw release, centerlines).
topbrain_data/*
!topbrain_data/anatomies/

# --- paper ------------------------------------------------------------
*.tex
*.pdf
report.bib

# --- run outputs ------------------------------------------------------
# Large, per-machine, and regenerable: stuck-checkpoint pools, heatup
# buffers, rendered figures.
saved/rcca_*/
saved/*_stuck/
saved/*heatup*/
saved/figs/
saved/figs - Copy/

# --- scratch ----------------------------------------------------------
scratchpad_pick.txt
.claude/scheduled_tasks.lock

# --- VMR downloads ----------------------------------------------------
# SimVascular projects from vascularmodel.com: hundreds of MB each, and
# redistributing them is the repository's job, not ours. Cite VMR when used.
vmr_data/

# --- carotid bifurcation database --------------------------------------
# CarotidAnalyzer lumen/plaque models from Zenodo, ~1 GB. CC-BY-4.0, so
# citable and reusable, but redistribution is the depositor's job.
# ...but not what WE derive from it. The composed anatomies are our own output
# and have to travel with the repo for any of this to be usable on another
# machine, exactly as topbrain_data/anatomies does. The small build records come
# too, so the shipped set can be checked against the plan that produced it.
#
# Note the trailing /* rather than /. Excluding the DIRECTORY makes git stop
# descending, and a later ! cannot re-include anything underneath it; excluding
# its CONTENTS leaves the negations below able to fire.
carotid_data/*
!carotid_data/anatomies/
!carotid_data/extended/
!carotid_data/pairing.json
!carotid_data/lower_manifest.json
!carotid_data/excluded_severed.json
