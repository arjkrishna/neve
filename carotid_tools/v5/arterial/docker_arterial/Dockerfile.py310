# [carotid_tools/v5 copy] source: C:\Users\akrish41\AppData\Local\Temp\claude\d--Arjun-neve\afabf2e9-c644-45a6-95cd-d6e6d88be352\scratchpad\v5_va\docker_arterial\Dockerfile.py310 (= /sp/v5_va/docker_arterial/Dockerfile.py310 in the build containers)
# neve-arterial:py310 (image 66003f1ef503): CPU-only runtime for the Arterial head-and-neck CTA pipeline
# (https://github.com/FLOWCAT-CV/arterial @3ff58ab, PolyForm-Noncommercial-1.0.0 code,
#  CC BY-NC 4.0 weights from Zenodo 10.5281/zenodo.22694951 -- mounted at run time at /models).
#
# Base: neve-build-vmtk (mambaorg/micromamba, conda-forge python 3.10.16 + vmtk 1.5.0 + vtk-base 9.2.6
# + numpy 1.26.4, libGL/X libs). Arterial declares python>=3.11 but uses no 3.11-only syntax; reusing
# the proven vmtk env avoids a fresh conda solve (the py3.11 env build, Dockerfile, looked stalled for
# 20+ min linking qt-main but did finish; it is the canonical neve-arterial:latest). Installed with --ignore-requires-python.
# No CUDA anywhere: torch from the PyTorch CPU index, PyG extensions from the +cpu index.
#
# Build (Git Bash, from this folder):  docker build -f Dockerfile.py310 -t neve-arterial:py310 .
FROM neve-build-vmtk:latest

USER root
ARG ARTERIAL_COMMIT=3ff58ab31a14f0416287cc66ceacca14b1918481

# numpy is held at the conda version (vtk/vmtk built against numpy 1.x) through a constraints file;
# vtk is NOT pip-installed (it would shadow the conda vtk that vmtk is linked against).
COPY constraints.txt /opt/constraints.txt
RUN /opt/conda/bin/python -m pip install --no-cache-dir -c /opt/constraints.txt \
        --index-url https://download.pytorch.org/whl/cpu torch==2.6.0
RUN /opt/conda/bin/python -m pip install --no-cache-dir -c /opt/constraints.txt \
        -f https://data.pyg.org/whl/torch-2.6.0+cpu.html \
        torch_geometric==2.6.1 pyg_lib==0.4.0+pt26cpu torch_scatter==2.1.2+pt26cpu torch_sparse==0.6.18+pt26cpu \
        torch_cluster==1.6.3+pt26cpu torch_spline_conv==1.2.2+pt26cpu
ARG NNUNET_VERSION=2.6.2
RUN /opt/conda/bin/python -m pip install --no-cache-dir -c /opt/constraints.txt \
        nnunetv2==${NNUNET_VERSION} monai==1.4.0 torchio==0.20.4 connected-components-3d==3.22.0 \
        nibabel networkx scipy scikit-image matplotlib psutil

# Arterial source at a pinned commit, installed without deps (deps are pinned above).
ADD https://github.com/FLOWCAT-CV/arterial/archive/${ARTERIAL_COMMIT}.tar.gz /opt/arterial_src.tar.gz
RUN mkdir -p /opt/arterial && tar xzf /opt/arterial_src.tar.gz -C /opt/arterial --strip-components=1 && \
    rm /opt/arterial_src.tar.gz && \
    /opt/conda/bin/python -m pip install --no-cache-dir --no-deps --ignore-requires-python -e /opt/arterial && \
    chmod -R a+rwX /opt/arterial

# CPU wrapper + VA summary (run_arterial.sh mounts newer copies from /sp/v5_va when present).
COPY arterial_cpu_run.py arterial_va_summary.py /opt/

ENV arterial_dir=/opt/arterial/arterial \
    ARTERIAL_MODELS_DIR=/models \
    nnUNet_raw=/tmp/nnunet_raw nnUNet_preprocessed=/tmp/nnunet_pre nnUNet_results=/tmp/nnunet_res \
    MPLBACKEND=Agg

# Smoke import at build time (fails the build if vmtk/vtk/torch/PyG/nnunet do not co-exist).
RUN /opt/conda/bin/python -c "import numpy, vtk, torch, torch_geometric, torch_cluster, nnunetv2, monai, torchio, cc3d, nibabel; from vmtk import vtkvmtk; import arterial.run.processor; print('numpy', numpy.__version__, 'vtk', vtk.vtkVersion.GetVTKVersion(), 'torch', torch.__version__, 'cuda', torch.cuda.is_available(), 'pyg', torch_geometric.__version__, 'monai', monai.__version__, 'nnunetv2 ok')"
